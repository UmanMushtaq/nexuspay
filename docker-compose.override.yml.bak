version: '3.9'

services:
  user-service:
    build:
      context: .
      dockerfile: apps/user-service/Dockerfile   # we'll create this later
    volumes:
      - ./apps/user-service:/app/apps/user-service
      - ./libs:/app/libs
      - ./node_modules:/app/node_modules
    command: npx nx serve user-service --watch
    ports:
      - "3001:3000"     # We'll run user-service on port 3001 to avoid conflict
    depends_on:
      - user-db
      - redis
      - rabbitmq
    environment:
      - NODE_ENV=development