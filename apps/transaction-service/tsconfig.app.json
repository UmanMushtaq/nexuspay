{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts", "src/application/**/*.ts", "common/**/*.ts", "src/domain/**/*.ts", "src/infrastructure/**/*.ts", "presentation/**/*.ts"],
  "exclude": []
}
